# Configuracion SQL Server (BD de afiliados - produccion)
DB_SERVER=nombre-o-ip-del-servidor-sql
DB_NAME=nombre-de-la-base
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_USER=usuario-sql-server
DB_PASSWORD=contraseña-sql-server

# Configuracion PostgreSQL (auditoria + usuarios)
PG_HOST=localhost
PG_PORT=5432
PG_NAME=obrasocial
PG_USER=tu-usuario-pg
PG_PASSWORD=tu-contraseña-pg

# Base de identidad centralizada (usuarios, roles, permisos, auditoria,
# accesos). Si las variables USR_* se dejan vacias, se reutiliza la conexion
# PG_* (host/puerto/usuario/password) apuntando a la base USR_NAME.
# SISTEMA_CODIGO debe coincidir con un codigo de la tabla "sistemas".
SISTEMA_CODIGO=obra_social
USR_HOST=
USR_PORT=
USR_NAME=usuarios
USR_USER=
USR_PASSWORD=

# JWT
# OBLIGATORIO: el sistema no arranca sin un secreto real.
# Generar uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=cambiar-por-un-secreto-seguro
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# CORS: origenes permitidos, separados por coma. En produccion el front usa
# el proxy /api/ (mismo origen), asi que aca solo hacen falta los de desarrollo
# o un dominio distinto al del front.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Documentacion interactiva de la API (/docs). Poner 1 SOLO en desarrollo.
ENABLE_DOCS=0
